# 复制为 .env 后填写一次；VS Code 按 F5 启动时会自动读取。
QWEATHER_API_KEY=你的和风天气Key
# 免费开发版通常使用 devapi；专属域名请替换为控制台分配的地址。
QWEATHER_API_HOST=https://devapi.qweather.com
# 仅当天气和地理服务使用不同域名时才需要设置。
# QWEATHER_GEO_HOST=https://geoapi.qweather.com

LLM_API_KEY=你的模型Key
LLM_MODEL=你的模型名称
# 使用 OpenAI 兼容服务时填写；官方 OpenAI 可留空。
# LLM_BASE_URL=https://你的模型服务地址/v1

API_HOST=127.0.0.1
API_PORT=8000
